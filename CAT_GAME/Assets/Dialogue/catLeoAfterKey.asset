  npcName: Leo
  npcPortrait: {fileID: 811902726, guid: 9bcb47500487a45b0af1ef47ef88c4b3, type: 3}
  dialogueLines:
  - Great! I can finally go home.
  - 'Oh, you are lost and looking for your owner? '
  - Hmm... it looks like you used to have a collar. Maybe you lost it around here. This way, we can help you find your owner!
  germanLines:
  - Super! Endlich kann ich nach Hause gehen.
  - Ach, du hast dich verlaufen und suchst deinen Besitzer?
  - "Hmm\u2026 es sieht so aus, als h\xE4ttest du fr\xFCher ein Halsband gehabt. Vielleicht hast du es hier irgendwo verloren. So k\xF6nnen wir dir helfen, deinen Besitzer zu finden!"
  spanishLines:
  - "\xA1Genial! Por fin puedo irme a casa."
  - "\xBFAh, te has perdido y est\xE1s buscando a tu due\xF1o?"
  - "Mmm\u2026 parece que antes llevabas un collar. Quiz\xE1 lo hayas perdido por aqu\xED. \xA1As\xED podremos ayudarte a encontrar a tu due\xF1o!"
  autoProgressLines: 
  autoProgressDelay: 1.5
  endDialogueLines: 000001y
